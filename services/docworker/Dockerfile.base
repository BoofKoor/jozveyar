# syntax=docker/dockerfile:1

# ایمیج پایهٔ کارگر اسناد — هر چیز سنگین و کم‌تغییر (ADR-027).
#
# LibreOffice، فونت‌ها و چرخ‌های پایتون. فقط در CI ساخته می‌شود و سرور آن را
# آماده با `docker load` می‌گیرد: LibreOffice از apt می‌آید و سرور نه به PyPI
# می‌رسد نه به مخزن Debian. شناسه‌اش هش همین ورودی‌هاست (`base-id.sh`)، پس تا
# این فایل، requirements.txt، fonts/ و fontconfig/ عوض نشده‌اند، سرور ۲۵۰
# مگابایت را دوباره دانلود نمی‌کند. کد کارگر روی این پایه در `Dockerfile` است.
#
# وصلهٔ امنیتی: LibreOffice فایل ناشناس کاربر را باز می‌کند، پس نسخهٔ کهنه‌اش
# خطر واقعی است. ماهی یک بار تاریخ زیر را عوض کنید؛ شناسه عوض می‌شود و پایه با
# آخرین وصله‌های Debian دوباره ساخته و منتشر می‌شود.
#
#   تازه‌سازی: ۱۴۰۵/۰۷/۰۱

# trixie صریح: وقتی تگ پیش‌فرض python به Debian بعدی برود، نام بسته‌های apt
# بی‌صدا عوض نمی‌شود.
FROM python:3.12-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8

# LibreOffice بدون رابط گرافیکی: فقط Writer (Word) و Impress (پاورپوینت).
#
# فونت‌ها: جایگزین هم‌اندازهٔ Times/Arial/Courier (Liberation) و Calibri/Cambria
# (Carlito/Caladea)، نسخ عربی Noto، فونت‌های فارسی‌وب (Nazli، Titr، Homa) و
# Tahoma پروژهٔ Wine که فارسی دارد. از Noto فقط لاتین، عربی و نمادها می‌مانند.
#
# حذف مستندات، قالب‌ها و گالری LibreOffice ~۶۰ مگابایت کم می‌کند؛ تبدیل به هیچ‌کدام
# دست نمی‌زند (تست‌های tests/test_base_image.py داخل همین ایمیج اجرا می‌شوند).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libreoffice-writer-nogui libreoffice-impress-nogui \
      fontconfig fonts-dejavu-core fonts-liberation fonts-crosextra-carlito \
      fonts-crosextra-caladea fonts-noto-core fonts-farsiweb fonts-wine \
 && tahoma="$(dpkg -L fonts-wine | grep -E '/tahoma(bd)?\.ttf$')" \
 && test -n "$tahoma" \
 && mkdir -p /usr/share/fonts/truetype/wine-tahoma \
 && ln -sf $tahoma /usr/share/fonts/truetype/wine-tahoma/ \
 && find /usr/share/fonts/truetype/noto -type f \
      ! -name 'NotoSans-*' ! -name 'NotoSerif-*' ! -name 'Noto*Arabic*' \
      ! -name 'NotoSansMath-*' ! -name 'NotoSansSymbols*' -delete \
 && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/* /usr/share/info/* \
      /usr/share/locale/* /usr/lib/libreoffice/share/gallery \
      /usr/lib/libreoffice/share/template /usr/lib/libreoffice/share/wizards

# چرخ‌های پایتون را CI کنار این فایل گذاشته (wheels/)؛ اینجا شبکه لازم نیست.
COPY wheels/ /tmp/wheels/
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --no-index --find-links /tmp/wheels -r /tmp/requirements.txt \
 && rm -rf /tmp/wheels /tmp/requirements.txt

# وزیرمتن کامل (OFL، خود فایل مجوز کنارش است) و نگاشت فونت‌های رایج Word ایرانی.
COPY fonts/ /usr/local/share/fonts/jozveyar/
COPY fontconfig/*.conf /etc/fonts/conf.d/

# کاربر غیر-root: کارگر فایل کاربر را باز می‌کند و نباید root باشد. پوشهٔ فونت‌های
# خصوصی (docworker/fonts.py) مال همین کاربر است.
RUN useradd -u 1002 -m docworker \
 && install -d -o docworker -g docworker /var/lib/docworker/fonts \
 && fc-cache -f

# اگر نگاشتی نگیرد یا LibreOffice بالا نیاید، همین‌جا در CI بشکند، نه روی سرور.
RUN check() { got="$(fc-match -f '%{family[0]}' "$1")"; [ "$got" = "$2" ] \
      || { echo "✗ fc-match «$1» ← «$got»؛ انتظار «$2»" >&2; exit 1; }; } \
 && check 'B Nazanin' Nazli \
 && check 'B Titr' Titr \
 && check IRANSans Vazirmatn \
 && check Vazirmatn Vazirmatn \
 && check Tahoma Tahoma \
 && check 'Times New Roman' 'Liberation Serif' \
 && check Arial 'Liberation Sans' \
 && check Calibri Carlito \
 && check Cambria Caladea \
 && soffice --version

WORKDIR /app
