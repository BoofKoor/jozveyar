# نسخه‌ای از این فایل با نام .env بسازید و پر کنید.
# .env هیچ‌وقت کامیت نمی‌شود و با deploy.sh هم منتقل نمی‌شود — فقط روی سرور می‌ماند.

# ── عمومی ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://jozveyar.com

# ── پایگاه داده ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://jozveyar:@postgres:5432/jozveyar

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── ذخیره‌سازی فایل (S3-سازگار، ADR-023) ─────────────────────────────────
# روی سرور، infra/setup-storage.sh مقادیر خالی را برای Garage همان سرور پر
# می‌کند. برای آروان یا پارس‌پک، مقادیر آنها را بگذارید و آن اسکریپت کنار
# می‌کشد. هیچ‌کدام خالی بماند، آپلود خاموش است و سایت مثل قبل کار می‌کند.
#
# S3_ENDPOINT         آدرسی که سرور با آن حرف می‌زند (داخل شبکهٔ داکر)
# S3_PUBLIC_ENDPOINT  آدرسی که مرورگر تکه‌ها را به آن می‌فرستد. برای Garage
#                     همان دامنهٔ سایت است (Nginx، مسیر /jozveyar/).
S3_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=https://jozveyar.com
S3_REGION=us-east-1
# نام باکت = مسیر Nginx (infra/nginx/snippets/storage.conf). با هم عوض شوند.
S3_BUCKET=jozveyar
# شکل Garage: GK + ۲۴ رقم hex، و ۶۴ رقم hex.
S3_ACCESS_KEY=
S3_SECRET_KEY=
GARAGE_RPC_SECRET=
# سقف کل حجم فایل‌های روی دیسک. پیش‌فرض ۴۰ گیگابایت (از ۸۷ آزاد).
# پر شد، آپلود تازه رد می‌شود و کاربر قیمت مرورگر را می‌بیند — نه دیسک پر.
STORAGE_BUDGET_BYTES=42949672960

# ── درگاه پرداخت ─────────────────────────────────────────────────────────
# mock تا نماد الکترونیک فعال شود، بعد zarinpal.
PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=https://jozveyar.com/pay/callback

# ── پیامک ────────────────────────────────────────────────────────────────
# console پیامک را در دیتابیس می‌نویسد تا OTP بدون پنل پیامکی قابل تست باشد.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_OTP_TEMPLATE=

# ── پنل ادمین ────────────────────────────────────────────────────────────
# ساب‌دامین جدا + مسیر پایهٔ محرمانه. مقدار زیر را عوض کنید.
ADMIN_BASE_PATH=/change-this-secret-path
SESSION_SECRET=
