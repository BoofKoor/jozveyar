# نسخه‌ای از این فایل با نام .env بسازید و پر کنید.
# .env هیچ‌وقت کامیت نمی‌شود و با deploy.sh هم منتقل نمی‌شود — فقط روی سرور می‌ماند.

# ── عمومی ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://jozveyar.com

# ── پایگاه داده ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://jozveyar:@postgres:5432/jozveyar

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── ذخیره‌سازی فایل (S3-سازگار، ADR-023) ─────────────────────────────────
# روی سرور، infra/setup-storage.sh مقادیر خالی را برای Garage همان سرور پر
# می‌کند. برای آروان یا پارس‌پک، مقادیر آنها را بگذارید و آن اسکریپت کنار
# می‌کشد. هیچ‌کدام خالی بماند، آپلود خاموش است و سایت مثل قبل کار می‌کند.
#
# S3_ENDPOINT         آدرسی که سرور با آن حرف می‌زند (داخل شبکهٔ داکر)
# S3_PUBLIC_ENDPOINT  آدرسی که مرورگر تکه‌ها را به آن می‌فرستد. برای Garage
#                     همان دامنهٔ سایت است (Nginx، مسیر /jozveyar/).
S3_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=https://jozveyar.com
S3_REGION=us-east-1
# نام باکت = مسیر Nginx (infra/nginx/snippets/storage.conf). با هم عوض شوند.
S3_BUCKET=jozveyar
# شکل Garage: GK + ۲۴ رقم hex، و ۶۴ رقم hex.
S3_ACCESS_KEY=
S3_SECRET_KEY=
GARAGE_RPC_SECRET=
# سقف کل حجم فایل‌های روی دیسک. پیش‌فرض ۴۰ گیگابایت (از ۸۷ آزاد).
# پر شد، آپلود تازه رد می‌شود و کاربر قیمت مرورگر را می‌بیند — نه دیسک پر.
STORAGE_BUDGET_BYTES=42949672960

# ── مسیر خرید (ADR-035) ──────────────────────────────────────────────────
# off   پیش‌فرض، و حالت سایت زنده تا صاحب پروژه روشنش کند: مسیرهای خرید ۴۰۴، و «ثبت سفارش آنلاین به‌زودی».
#       برگشت از درگاه و استعلام پرداخت‌هایی که در راه‌اند با درگاهی که PAYMENT_PROVIDER می‌گوید کار می‌کنند (برش ۷٫۵).
# mock  محلی و CI: درگاه نمونه و پیامک کنسولی. روی jozveyar.com هرگز، حتی با همین مقدار:
#       دامنه از خود درخواست خوانده می‌شود.
# live  برش ۷٫۵ (ADR-052): زیبال و sms.ir، فقط وقتی همه چیز آماده است — PAYMENT_PROVIDER=zibal، SMS_PROVIDER=smsir، کد
#       پذیرنده، کلید API، سه شناسهٔ قالب، PAYMENT_CALLBACK_URL، پایگاه داده و SESSION_SECRET؛ وگرنه مثل off، با خطی در
#       لاگ که چه کم است. مخاطب از «تنظیمات» پنل: «پیش‌نمایش مالک» (پیش‌فرض)، «همه» یا «متوقف».
# مسیر خرید SESSION_SECRET (دست‌کم ۳۲ نویسه) و پایگاه داده هم می‌خواهد؛ بی آنها خاموش است.
CHECKOUT_MODE=off

# ── درگاه پرداخت ─────────────────────────────────────────────────────────
# zibal: برگشت و استعلام زیبال در هر حالت، و شروع پرداخت در CHECKOUT_MODE=live (برش ۷٫۵)؛ mock یعنی وب هیچ درگاهی ندارد
# (درگاه نمونهٔ CHECKOUT_MODE=mock جداست). mock اینجا مسیر خرید را روشن نمی‌کند.
# PAYMENT_MERCHANT_ID، SMS_API_KEY و SMS_OTP_TEMPLATE را از پنل ادمین هم می‌شود گذاشت (برش ۴٫۶، ADR-041)،
# مهروموم با SECRETS_KEY؛ مقدار پنل بر مقدار اینجا مقدم است و «برگرداندن به .env» دوباره همین را به کار می‌برد.
# PAYMENT_CALLBACK_URL نشانی پایهٔ برگشت از درگاه است، https و همان دامنه‌ای که در پنل زیبال ثبت شده (بی www)؛ سرور کلید تصادفی
# هر تلاش را به تهش می‌افزاید (برش ۷٫۲، ADR-050). «آزمایش» کد پذیرنده در پنل هم بی آن نمی‌رود.
PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=https://jozveyar.com/pay/callback

# ── پیامک ────────────────────────────────────────────────────────────────
# console پیامک را در دیتابیس می‌نویسد تا OTP بدون پنل پیامکی قابل تست باشد.
# CHECKOUT_MODE=mock همیشه کنسولی است؛ وگرنه وب و پنل همین را می‌خوانند (برش ۷٫۵)، و live آماده smsir می‌خواهد.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_OTP_TEMPLATE=

# ── پنل ادمین (برش ۴، ADR-037) ───────────────────────────────────────────
# زیردامنهٔ جدا + مسیر محرمانه. bootstrap.sh همه را می‌سازد، و deploy-bundle.sh هر کدام که نباشد (بی چاپ
# مقدار). مسیر دست‌کم ۱۶ نویسه از [A-Za-z0-9_-] است و همین جای‌نگهدار پذیرفته نیست: پنل بسته می‌ماند.
ADMIN_BASE_PATH=/change-this-secret-path
ADMIN_ORIGIN=https://admin.jozveyar.com
# مهروموم رمزهای برنامهٔ تأیید ادمین‌ها و کلیدهای سرویس‌هایی که از پنل گذاشته شده (۴٫۶): ۶۴ رقم hex (openssl rand -hex 32).
# گم شود، ادمین‌ها با ./infra/admin-invite.sh از نو ثبت می‌کنند و کلیدهای پنل «خوانده نشد» می‌شوند تا دوباره وارد شوند؛
# از .env نسخهٔ پشتیبان بگیرید.
SECRETS_KEY=
# کلید HMAC کد پیامکی، IP و نشست‌ها؛ دست‌کم ۳۲ نویسه. مسیر خرید و پنل هر دو می‌خواهندش.
SESSION_SECRET=
ADMIN_MEM_LIMIT=384m
