{
  "name": "jozveyar",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @jozveyar/web dev",
    "build": "pnpm -r --filter=!@jozveyar/web build && pnpm --filter @jozveyar/web build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @jozveyar/web lint",
    "check": "pnpm typecheck && pnpm test",
    "test:e2e": "pnpm --filter @jozveyar/web build && pnpm --filter @jozveyar/web test:e2e",
    "fixtures": "node apps/web/tests/make-fixtures.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
